# =============================================================================
# Vértice — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Anthropic (LLM operativo + supervisor) -----------------------------------
ANTHROPIC_API_KEY=

# --- Deepgram STT (Nova-3 Multilingual streaming) -----------------------------
# Cemented: model nova-3-general, language=multi (ES↔EN code-switching for
# financial jargon: equity, leverage, covenant, DSCR, stress test).
DEEPGRAM_API_KEY=

# --- Neon Postgres + pgvector -------------------------------------------------
DATABASE_URL=
# Connection string a una Neon branch DEDICADA para integration tests. Sin esta
# var, los tests `*.integration.test.ts` se skipean (no rompen el suite). NO usar
# la branch main aquí — los tests truncan tablas.
DATABASE_URL_TEST=

# --- Resend (magic links) -----------------------------------------------------
RESEND_API_KEY=
# Sender canónico. Dominio `verticemexico.com` verificado en Resend
# (DKIM + SPF auto-config via Cloudflare, May 11 2026). Si rotas el dominio,
# actualizar Resend → Domains + verificar nuevos TXT records.
EMAIL_FROM=hola@verticemexico.com

# --- Inngest (background jobs: síntesis final) --------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sentry (errores) ---------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Axiom (logs estructurados de LLM calls) ----------------------------------
AXIOM_TOKEN=
AXIOM_DATASET=vertice-prod

# --- Upstash Redis (rate-limit distribuido) — Sprint 2 security audit --------
# Sin estas vars, el rate-limit cae a fallback in-memory token-bucket — válido
# en dev/tests, INVÁLIDO en Vercel serverless multi-instance (cada Lambda tiene
# su propio bucket y un atacante multiplica el cap real por N instances).
# Provisionar en https://console.upstash.com → Create Database:
#   Name: vertice-ratelimit / Type: Regional / Region: us-east-1 / TLS: on
#   Eviction: allkeys-lru / Plan: Free (10K commands/day)
# Las dos vars están en el panel REST API de la DB.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Recipients de la notificación email de síntesis completa (Fase 8).
# Lista comma-separated. Sin esto el step notificar-admin no-op + log.
ADMIN_EMAILS=founder@vertice.app,otro@vertice.app

# Vercel Blob token para PDFs de síntesis (Fase 8). Vercel → Storage → Blob.
# Sin esto, el PDF se genera pero no se persiste URL — email sale con sólo
# link a /admin/sesiones/{id} y degradación grácil.
BLOB_READ_WRITE_TOKEN=

# --- Auth.js v6 (Google SSO) — Sprint 1 security audit 2026-05-12 -------------
# Path canónica de auth admin + entrevistado. Crear OAuth Client en GCP
# Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web app).
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<tu-dominio>/api/auth/callback/google    (prod)
# Scope mínimo: openid email profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JWT signing key (32 bytes random base64url). Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Auth.js usa esto para firmar el cookie de sesión. Rotarlo invalida TODAS
# las sesiones activas — útil en compromise.
AUTH_SECRET=
# URL canónica del deployment. Auth.js v6 la usa para computar el redirect_uri
# del OAuth callback. En dev se auto-detecta y puedes omitirla. En prod ES
# OBLIGATORIA — si no coincide con un redirect URI del OAuth Client, Google
# rechaza el callback con redirect_uri_mismatch.
#   dev: omitir o http://localhost:3000
#   prod: https://<tu-dominio>
AUTH_URL=

# --- Admin panel emergency fallback -------------------------------------------
# Token compartido legacy. Solo se acepta cuando ADMIN_EMERGENCY_MODE=1.
# Por default (sin la flag), /admin/login solo ofrece Google SSO. Mantener el
# token rotable en este env por si Google OAuth se cae o las credenciales
# se revocan. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PANEL_TOKEN=
# Cuando =1: el form de token aparece en /admin/login como fallback junto al
# botón Google. NO setearlo a 1 en prod a menos que estés en incident.
ADMIN_EMERGENCY_MODE=
# Whitelist de admins para Google SSO. Lista separada por comas.
# - Entry con @ → email específico (whitelist exacta).
# - Entry sin @ → dominio entero (cualquier email @ese-dominio entra como admin).
# Útil para soportar tanto la cuenta personal del founder pre-Google Workspace
# como el dominio corporativo futuro.
VERTICE_ADMIN_DOMAINS=verticemexico.com

